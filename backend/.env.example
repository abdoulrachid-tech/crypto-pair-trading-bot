PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/trading_bot

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS : origine(s) du frontend autorisée(s) à appeler cette API.
# Plusieurs valeurs possibles séparées par des virgules, pour activer
# local + LAN + en ligne en même temps, ex. :
# FRONTEND_ORIGIN=http://localhost:5173,http://192.168.1.50:5173,https://mon-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# 'lax' pour local/LAN en HTTP (par défaut). Mettre 'none' uniquement si le
# frontend est déployé en ligne sur un domaine différent du backend (exige
# alors HTTPS des deux côtés).
COOKIE_SAME_SITE=lax

# Token statique optionnel permettant au bot Python de s'authentifier
# auprès des routes /api/bot/* sans passer par le flux JWT utilisateur.
BOT_API_TOKEN=change_this_bot_token
