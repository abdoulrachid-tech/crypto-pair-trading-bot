# --- Exchange (CCXT) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Mettre à true pour utiliser le testnet/sandbox de l'exchange si disponible
EXCHANGE_SANDBOX=true

# --- Base PostgreSQL (données historiques / backtests) ---
# Fonctionne aussi bien avec le conteneur Docker fourni (docker-compose.yml)
# qu'avec un PostgreSQL natif installé sur la machine : seuls host/port
# changent selon le cas. Voir scripts/setup_postgres_native.sql pour créer
# le rôle et la base sur une install native.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_data
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=my_strong_password

# --- Paire tradée ---
SYMBOL_A=BTC/USDT
SYMBOL_B=ETH/USDT
TIMEFRAME=1m

# --- Paramètres de stratégie (valeurs par défaut, recalibrées automatiquement) ---
ZSCORE_WINDOW=200
ZSCORE_ENTRY=2.0
ZSCORE_EXIT=0.5
ZSCORE_STOPLOSS=4.0

# --- Mode d'exécution ---
# "simulation" (paper trading, aucun ordre réel) ou "live" (ordres réels)
TRADING_MODE=simulation
# Deuxième interrupteur obligatoire pour que le mode live soit effectif
# (garde-fou volontaire : voir README, section "Passer en mode réel").
# Tant que ce n'est pas "true", le bot reste en simulation même si
# TRADING_MODE=live.
LIVE_TRADING_CONFIRMED=false
TRADE_SIZE_QUOTE=100
MIN_SECONDS_BETWEEN_TRADES=60

# --- API backend (Express.js) : le bot y pousse logs/trades ---
BACKEND_API_URL=http://localhost:5000/api
BACKEND_API_TOKEN=

# --- Alertes Telegram (optionnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cycle du bot ---
CYCLE_INTERVAL_SECONDS=300
RECALIBRATION_INTERVAL_HOURS=168
