# Ce fichier est une référence globale listant toutes les variables
# d'environnement du projet. En pratique, chaque sous-dossier a son propre
# .env.example plus précis :
#   - trading-bot/.env.example
#   - backend/.env.example
#
# Copiez-les et éditez-les individuellement plutôt que d'utiliser celui-ci
# directement.

# ============ PostgreSQL (trading-bot/) ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_data
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=my_strong_password

# ============ MongoDB (backend/) ============
MONGODB_URI=mongodb://localhost:27017/trading_bot

# ============ Exchange / CCXT (trading-bot/) ============
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true

# ============ Sécurité API (backend/) ============
JWT_SECRET=change_this_to_a_long_random_string
BOT_API_TOKEN=change_this_bot_token

# ============ Alertes (trading-bot/) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
